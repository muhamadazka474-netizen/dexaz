# ============================================================
# DEXAZ environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env to Git.
# ============================================================

# --- App / internal database ---
# Internal SQLite DB used by DEXAZ itself (users, saved connections,
# saved queries, query history, audit log). NOT your target database.
DBX_INTERNAL_DB_URL=sqlite:///./dbxplorer_internal.db

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-different-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used to encrypt target database passwords stored in the internal DB.
ENCRYPTION_KEY=change-me-fernet-key

# --- Default admin (seeded on first run) ---
DBX_ADMIN_USERNAME=admin
DBX_ADMIN_PASSWORD=change-me-on-first-login

# --- Server binding (local-first: keep these as-is unless you know what you're doing) ---
DBX_HOST=127.0.0.1
DBX_PORT=8000

# --- CORS: frontend origin(s) allowed to call the API ---
# Comma-separated if you need more than one, e.g. local dev (see package.json "dev" script for the port) + a deployed
# Vercel frontend: http://127.0.0.1:3001,https://your-app.vercel.app
DBX_FRONTEND_ORIGIN=http://127.0.0.1:3001

# --- Hardening for when the backend is exposed via a public tunnel ---
# /api/fs/* lets a logged-in user browse your ENTIRE local disk (any
# drive/folder your OS user can read). Fine when only 127.0.0.1 can reach
# the backend; risky once it's tunneled to the internet. Set to false
# while tunneling unless you actively need the "Browse..." file picker.
DBX_ENABLE_FS_BROWSER=true

# Lock out an account after this many failed login attempts within the
# lockout window (minutes). Protects against password guessing once the
# backend is reachable from the internet.
DBX_LOGIN_MAX_ATTEMPTS=5
DBX_LOGIN_LOCKOUT_MINUTES=15

# --- Query safety limits ---
DBX_QUERY_TIMEOUT_SECONDS=30
DBX_MAX_ROWS_RETURNED=10000
DBX_DEFAULT_PAGE_SIZE=100
DBX_EXPORT_MAX_ROWS=50000

# --- Optional: bootstrap connection ---
# If filled in, DEXAZ auto-creates this database connection the first
# time the backend starts (so you don't have to add it by hand in the UI).
# Safe to leave blank — nothing happens if DBX_BOOTSTRAP_NAME is empty.
# The password is encrypted with ENCRYPTION_KEY before being stored; it is
# never written back out in plaintext once saved.
DBX_BOOTSTRAP_NAME=
DBX_BOOTSTRAP_DB_TYPE=postgresql
DBX_BOOTSTRAP_HOST=127.0.0.1
DBX_BOOTSTRAP_PORT=5432
DBX_BOOTSTRAP_DATABASE=
DBX_BOOTSTRAP_USERNAME=
DBX_BOOTSTRAP_PASSWORD=
DBX_BOOTSTRAP_SSL_MODE=prefer
