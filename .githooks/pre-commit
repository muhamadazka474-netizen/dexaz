#!/usr/bin/env bash
# Pre-commit safety net: refuses the commit if a real .env file (or any
# other obvious secrets file) is staged. Belt-and-suspenders on top of
# .gitignore — protects you even if .gitignore is ever edited by mistake.
#
# One-time setup (run once per clone):
#   git config core.hooksPath .githooks
#
# After that, this runs automatically on every `git commit`.

set -euo pipefail

blocked_pattern='(^|/)\.env($|\.[^.]*$)'
allowed_pattern='\.env\.example$'

staged_files=$(git diff --cached --name-only)

offenders=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  if echo "$f" | grep -Eq "$blocked_pattern" && ! echo "$f" | grep -Eq "$allowed_pattern"; then
    offenders="$offenders$f\n"
  fi
done <<< "$staged_files"

if [ -n "$offenders" ]; then
  echo "----------------------------------------------------------------"
  echo "COMMIT BLOCKED: you're about to commit a file that looks like a"
  echo "real secrets file (not .env.example):"
  echo -e "$offenders"
  echo "If this is really safe to commit, unstage it first with:"
  echo "  git reset HEAD <file>"
  echo "or run 'git commit --no-verify' if you are certain (not recommended)."
  echo "----------------------------------------------------------------"
  exit 1
fi

exit 0
