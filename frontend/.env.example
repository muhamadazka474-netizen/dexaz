# Copy to .env.local for local dev, or set as an Environment Variable
# in your Vercel project settings for production.
#
# Local dev (backend running on your PC):
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#
# Production on Vercel (backend exposed via a tunnel, e.g. Cloudflare
# Tunnel / ngrok, since the backend still runs on your own PC):
# NEXT_PUBLIC_API_URL=https://your-tunnel-subdomain.example.com
